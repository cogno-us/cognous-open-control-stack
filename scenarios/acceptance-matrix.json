{
  "matrix_version": "1.0",
  "evidence_rule": "Each entry names executable upstream tests at component-lock.json pins. Actual pass/fail is established by final-head JUnit and raw logs, not by this mapping.",
  "scenarios": [
    {
      "id": "valid_t1_refund",
      "tests": [
        "control_plane::test_valid_t1_succeeds_and_changes_destination",
        "gax_reference::test_run_exchange_success_uses_assessed_request_supplied_resolver_destination_and_successor"
      ],
      "expected": "one bound effect; observed applied"
    },
    {
      "id": "t2_approval",
      "tests": [
        "control_plane::test_t2_requires_additional_approval"
      ],
      "expected": "no effect without required approval; correctly bound approval permits bounded effect"
    },
    {
      "id": "authority_missing_revoked_expired_stale",
      "tests": [
        "gax_reference::test_run_exchange_missing_resolver_fails_closed_without_effect",
        "control_plane::test_revocation_expiry_stale_status_and_policy_change_hold",
        "control_plane::test_stale_approval_identity_and_mandate_hold"
      ],
      "expected": "hold/deny and zero new effect"
    },
    {
      "id": "binding_substitution",
      "tests": [
        "control_plane::test_substitution_prevents_effect",
        "control_plane::test_resolver_record_identifier_binding_is_enforced",
        "gax_reference::test_run_exchange_altered_actor_principal_or_scope_cannot_acquire_authority",
        "governed_transport::test_envelope_identity_substitution_rejected",
        "governed_transport::test_multi_sender_route_substitution_rejected"
      ],
      "expected": "actor/principal/institution-domain/target/adapter/payload substitutions fail closed"
    },
    {
      "id": "policy_changed_after_decision",
      "tests": [
        "control_plane::test_changed_policy_after_decision_prevents_effect",
        "gax_reference::test_run_exchange_revocation_after_decision_prevents_execution"
      ],
      "expected": "effect-time revalidation blocks stale decision"
    },
    {
      "id": "bad_evidence",
      "tests": [
        "control_plane::test_requirement_only_or_copied_verification_json_cannot_authorize",
        "control_plane::test_wrong_evidence_source_binding_holds_and_no_effect",
        "bitrep_verification",
        "replay::test_payload_commitment_tamper_is_rejected"
      ],
      "expected": "malformed/forged/copied evidence cannot create authority"
    },
    {
      "id": "required_stale_vs_optional_unknown",
      "tests": [
        "control_plane::test_stale_required_evidence_holds_but_optional_unknown_does_not"
      ],
      "expected": "required stale holds; explicitly optional unknown may continue"
    },
    {
      "id": "non_action_messages",
      "tests": [
        "gax_reference::test_report_refuse_not_understood_never_execute",
        "governed_transport::test_informational_acts_produce_no_effect"
      ],
      "expected": "REPORT/REFUSE/NOT_UNDERSTOOD create no effect"
    },
    {
      "id": "multi_sender_shared_recipient",
      "tests": [
        "governed_transport::test_multiple_valid_senders_share_recipient_without_first_route_bias"
      ],
      "expected": "legitimate configured senders remain distinct and routable"
    },
    {
      "id": "message_id_and_replay",
      "tests": [
        "governed_transport::test_altered_content_and_message_id_reuse_conflict_are_rejected",
        "governed_transport::test_duplicate_and_out_of_order_delivery_suppresses_second_assessment"
      ],
      "expected": "conflicting reuse rejected; duplicate/distinct delivery semantics preserve identity"
    },
    {
      "id": "duplicate_lost_ack_restart",
      "tests": [
        "control_plane::test_lost_ack_restart_reconciles_without_duplicate",
        "control_plane::test_duplicate_submission_does_not_duplicate_effect",
        "gax_reference::test_lost_ack_exact_redelivery_preserves_unknown_unresolved_without_second_effect",
        "governed_transport::test_lost_ack_restart_recovery_preserves_message_and_attempt_lineage"
      ],
      "expected": "same effect identity, no blind duplicate"
    },
    {
      "id": "interruption_after_inbox",
      "tests": [
        "governed_transport::test_interruption_after_receipt_redelivery_is_unresolved_not_rejection"
      ],
      "expected": "durable receipt retained; unresolved outcome is not promoted"
    },
    {
      "id": "interruption_after_commit",
      "tests": [
        "gax_reference::test_checkpoint_after_destination_commit_recovers_original_effect_without_replacement",
        "gax_reference::test_replay_odes_failure_after_commit_retries_evidence_without_repeating_effect",
        "governed_transport::test_interruption_after_effect_before_outcome_persistence_does_not_repeat_effect"
      ],
      "expected": "effect identity preserved; evidence recovery creates no replacement effect"
    },
    {
      "id": "partial_and_unavailable_observation",
      "tests": [
        "control_plane::test_partial_delivery_holds_instead_of_blind_retry",
        "gax_reference::test_run_exchange_partial_delivery_successor_reports_pending_unresolved_effect",
        "gax_reference::test_partial_delivery_exact_redelivery_preserves_pending_and_unresolved"
      ],
      "expected": "partial/unknown remain unresolved"
    },
    {
      "id": "continuity_tamper",
      "tests": [
        "gax_reference::test_successor_lineage_rejects_wrong_conversation_stale_and_divergent_branch",
        "gax_reference::test_copied_predecessor_digest_field_cannot_mask_altered_content",
        "gax_reference::test_caller_supplied_predecessor_content_cannot_establish_history_when_rehashed"
      ],
      "expected": "rollback/divergence/copied digest rejected"
    },
    {
      "id": "replay_import_redaction_no_effect",
      "tests": [
        "replay::test_redaction_creates_new_derivative_identity_and_drops_stale_hmac",
        "replay::test_missing_proposal_with_moltbot_evidence_is_rejected_not_promoted_complete",
        "evidence_pack::test_replay_findings_and_redaction_derivation_are_preserved"
      ],
      "expected": "derived/replayed artifacts do not authorize or execute a new effect"
    },
    {
      "id": "test_provenance",
      "tests": [
        "evidence_pack::test_malformed_test_provenance_values_leave_tested_unavailable_with_finding",
        "evidence_pack::test_failed_attributed_test_result_is_preserved_and_rendered_as_source_assertion"
      ],
      "expected": "malformed provenance unavailable; failed attribution remains visibly failed"
    },
    {
      "id": "bitrep_index_non_authorizing",
      "tests": [
        "bitrep_verification",
        "index_bitrep_binding",
        "index_local_chain"
      ],
      "expected": "signature verification and local-chain inclusion are evidence properties, never execution authority"
    }
  ]
}
