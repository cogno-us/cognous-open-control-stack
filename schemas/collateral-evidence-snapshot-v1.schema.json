{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cogno-us/cognous-open-control-stack/schemas/collateral-evidence-snapshot-v1.schema.json",
  "title": "Collateral Evidence Snapshot Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "version",
    "generated_at",
    "snapshot_status",
    "accepted_hub_pin",
    "component_lock",
    "evidence_generation",
    "separate_profile_evidence",
    "assurance_levels",
    "documents",
    "historical_snapshots",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "collateral-evidence-snapshot/1" },
    "document_id": { "const": "cognous-collateral-evidence-snapshot" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "snapshot_status": { "const": "current" },
    "accepted_hub_pin": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "component_lock": {
      "type": "object",
      "required": ["path", "sha256", "runtime_profile", "qualification_status", "selected_control_plane", "selected_execution_runtime"]
    },
    "evidence_generation": {
      "type": "object",
      "required": ["id", "status", "workflow_run", "tested_source_sha", "accepted_hub_merge", "acceptance_scenarios", "artifact_sha256", "scope"]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document_id", "version", "path", "status", "evidence_scope", "document_sha256"]
      }
    },
    "historical_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "path", "status", "evidence_generation", "note"]
      }
    }
  },
  "additionalProperties": false
}
