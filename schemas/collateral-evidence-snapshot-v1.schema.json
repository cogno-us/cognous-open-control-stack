{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cogno-us/cognous-open-control-stack/schemas/collateral-evidence-snapshot-v1.schema.json",
  "title": "Collateral Evidence Snapshot Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "version",
    "generated_at",
    "snapshot_status",
    "accepted_hub_pin",
    "component_lock",
    "evidence_generation",
    "separate_profile_evidence",
    "assurance_levels",
    "documents",
    "historical_snapshots",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "collateral-evidence-snapshot/1"
    },
    "document_id": {
      "const": "cognous-collateral-evidence-snapshot"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(\\+00:00|Z)$"
    },
    "snapshot_status": {
      "const": "current"
    },
    "accepted_hub_pin": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "component_lock": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "runtime_profile",
        "qualification_status",
        "selected_control_plane",
        "selected_execution_runtime"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "component-lock.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_profile": {
          "type": "string"
        },
        "qualification_status": {
          "type": "string"
        },
        "selected_control_plane": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "selected_execution_runtime": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "evidence_generation": {
      "type": "object",
      "required": [
        "id",
        "status",
        "workflow_run",
        "tested_source_sha",
        "accepted_hub_merge",
        "acceptance_scenarios",
        "artifact_sha256",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "const": "accepted_default_release"
        },
        "workflow_run": {
          "type": "integer"
        },
        "tested_source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "accepted_hub_merge": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "acceptance_scenarios": {
          "type": "integer"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope": {
          "type": "string",
          "const": "bounded synthetic default release; local SQLite destination; no production or external settlement claim"
        }
      },
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "version",
          "path",
          "status",
          "evidence_scope",
          "document_sha256"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "const": "current"
          },
          "evidence_scope": {
            "type": "string"
          },
          "document_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "historical_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "path",
          "status",
          "evidence_generation",
          "note"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence_generation": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "separate_profile_evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "c1-same-host-authority-effect",
              "v1-reference-extension-evidence/5"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "separate_optional_profile_ci",
              "separate_contract_population"
            ]
          },
          "workflow_run": {
            "type": "integer"
          },
          "passed_tests": {
            "type": "integer"
          },
          "failures": {
            "type": "integer"
          },
          "errors": {
            "type": "integer"
          },
          "skips": {
            "type": "integer"
          },
          "control_plane_reviewed_source_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "execution_runtime_reviewed_source_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "required_profile_cases": {
            "type": "integer"
          },
          "aggregate_negative_unit_checks": {
            "type": "integer"
          },
          "scope": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "assurance_levels": {
      "type": "object",
      "required": [
        "C0",
        "C1",
        "C2",
        "C3"
      ],
      "properties": {
        "C0": {
          "type": "string",
          "const": "selected default pre-effect revalidation; residual check-to-commit race; not destination commit atomicity"
        },
        "C1": {
          "type": "string",
          "const": "optional same-host participating SQLite ordering only; not enabled by default"
        },
        "C2": {
          "type": "string"
        },
        "C3": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
