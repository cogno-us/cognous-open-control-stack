{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ocs-catalogue/lineage_sets/0",
  "title": "Lineage set of historical revision records",
  "description": "A named, ordered set of historical revision records that belong together (an append-only log). Not a rule, scenario or test; informational; non-authorizing; authority none.",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "revision",
        "path",
        "anchor"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mvp_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "reason"
      ],
      "properties": {
        "value": {
          "enum": [
            "mvp_fixed",
            "other_supported_historical_profile",
            "requires_unavailable_component",
            "needs_migration",
            "historical_only",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "basis_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision_id",
          "raw_ref",
          "digest",
          "relation"
        ],
        "properties": {
          "revision_id": {
            "type": "string",
            "minLength": 1
          },
          "raw_ref": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "relation": {
            "const": "HISTORICAL_REVISION"
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aliases",
    "annotations",
    "authority",
    "catalogue_id",
    "digest",
    "layer",
    "lineage",
    "mvp_applicability",
    "native_ids",
    "non_authorizing",
    "raw_refs",
    "release_scope",
    "source",
    "tier",
    "title"
  ],
  "properties": {
    "layer": {
      "const": "lineage_sets"
    },
    "authority": {
      "const": "none"
    },
    "non_authorizing": {
      "const": true
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "annotations": {
      "type": "object"
    },
    "catalogue_id": {
      "type": "string",
      "pattern": "^L-[!-~]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "native_ids": {
      "type": "array"
    },
    "aliases": {
      "type": "array"
    },
    "raw_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "tier": {
      "const": "LINEAGE_SET"
    },
    "release_scope": {
      "enum": [
        "v0_1",
        "post_v0_1",
        "unknown"
      ]
    },
    "mvp_applicability": {
      "$ref": "#/$defs/mvp_applicability"
    }
  }
}
