{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ocs-catalogue/fixtures/0",
  "title": "L4 fixture reference",
  "description": "Reference plus digest only; fixture bytes are never copied. Informational catalogue entry; non-authorizing; authority none; activates nothing; release and production remain on HOLD.",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "revision",
        "path",
        "anchor"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mvp_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "reason"
      ],
      "properties": {
        "value": {
          "enum": [
            "mvp_fixed",
            "other_supported_historical_profile",
            "requires_unavailable_component",
            "needs_migration",
            "historical_only",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "basis_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision_id",
          "raw_ref",
          "digest",
          "relation"
        ],
        "properties": {
          "revision_id": {
            "type": "string",
            "minLength": 1
          },
          "raw_ref": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "relation": {
            "const": "HISTORICAL_REVISION"
          }
        }
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "to",
        "provenance",
        "source",
        "method",
        "supporting_refs",
        "confidence_class",
        "missing_evidence",
        "establishes_enforcement",
        "establishes_test_coverage",
        "establishes_qualification"
      ],
      "properties": {
        "field": {
          "enum": [
            "scenario_refs",
            "rule_refs",
            "test_refs",
            "fixture_refs",
            "evidence_digest_refs",
            "test_ref",
            "scenario_ref",
            "alias_candidates",
            "related_refs",
            "source_reference_refs"
          ]
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "enum": [
            "SOURCE_STATED",
            "DERIVED",
            "UNRESOLVED"
          ]
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repo",
                "revision",
                "location"
              ],
              "properties": {
                "repo": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "location": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "supporting_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence_class": {
          "enum": [
            "high",
            "medium",
            "low",
            "heuristic",
            null
          ]
        },
        "missing_evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "establishes_enforcement": {
          "const": false
        },
        "establishes_test_coverage": {
          "const": false
        },
        "establishes_qualification": {
          "const": false
        },
        "row_id": {
          "type": "string",
          "pattern": "^REL-[0-9a-f]{16}$"
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "assess_c": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "has_unresolved"
          ]
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assess_l": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "source_stated_link",
            "derived_candidate_only",
            "none"
          ]
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assess_q": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "source_stated_record",
            "none"
          ]
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aliases",
    "annotations",
    "authority",
    "catalogue_id",
    "digest",
    "evidence_digest_refs",
    "expected_outcome_verbatim",
    "fixture_identity",
    "layer",
    "lineage",
    "locations",
    "mvp_applicability",
    "native_ids",
    "non_authorizing",
    "raw_refs",
    "relationships",
    "release_scope",
    "source",
    "tier",
    "title"
  ],
  "properties": {
    "layer": {
      "const": "fixtures"
    },
    "authority": {
      "const": "none"
    },
    "non_authorizing": {
      "const": true
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "annotations": {
      "type": "object"
    },
    "catalogue_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "native_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "raw_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "tier": {
      "const": "FIXTURE"
    },
    "fixture_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "content_sha256"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "expected_outcome_verbatim": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_digest_refs": {
      "$ref": "#/$defs/refs"
    },
    "mvp_applicability": {
      "$ref": "#/$defs/mvp_applicability"
    },
    "release_scope": {
      "enum": [
        "v0_1",
        "post_v0_1",
        "unknown"
      ]
    },
    "relationships": {
      "$ref": "#/$defs/relationships"
    },
    "alias_candidates": {
      "$ref": "#/$defs/refs"
    },
    "source_reference_refs": {
      "$ref": "#/$defs/refs"
    }
  }
}
