{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ocs-catalogue/coverage/0",
  "title": "L6 coverage projection row (derived)",
  "description": "Derived from explicit links only; no state is inferred from another layer. Informational catalogue entry; non-authorizing; authority none; activates nothing; release and production remain on HOLD.",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "revision",
        "path",
        "anchor"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mvp_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "reason"
      ],
      "properties": {
        "value": {
          "enum": [
            "mvp_fixed",
            "other_supported_historical_profile",
            "requires_unavailable_component",
            "needs_migration",
            "historical_only",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision_id",
          "raw_ref",
          "digest",
          "relation"
        ],
        "properties": {
          "revision_id": {
            "type": "string",
            "minLength": 1
          },
          "raw_ref": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "relation": {
            "const": "HISTORICAL_REVISION"
          }
        }
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "to",
        "provenance",
        "source",
        "method",
        "supporting_refs",
        "confidence_class",
        "missing_evidence",
        "establishes_enforcement",
        "establishes_test_coverage",
        "establishes_qualification"
      ],
      "properties": {
        "field": {
          "enum": [
            "scenario_refs",
            "rule_refs",
            "test_refs",
            "fixture_refs",
            "evidence_digest_refs",
            "test_ref",
            "scenario_ref",
            "alias_candidates"
          ]
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "enum": [
            "SOURCE_STATED",
            "DERIVED",
            "UNRESOLVED"
          ]
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repo",
                "revision",
                "location"
              ],
              "properties": {
                "repo": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "location": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "supporting_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence_class": {
          "enum": [
            "high",
            "medium",
            "low",
            "heuristic",
            null
          ]
        },
        "missing_evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "establishes_enforcement": {
          "const": false
        },
        "establishes_test_coverage": {
          "const": false
        },
        "establishes_qualification": {
          "const": false
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "assess_c": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "has_unresolved"
          ]
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assess_l": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "source_stated_link",
            "derived_candidate_only",
            "none"
          ]
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assess_q": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "source_stated_record",
            "none"
          ]
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annotations",
    "assessments",
    "authority",
    "digest",
    "layer",
    "mvp_applicability",
    "non_authorizing",
    "states",
    "status_note",
    "subject_id",
    "subject_layer"
  ],
  "properties": {
    "layer": {
      "const": "coverage"
    },
    "authority": {
      "const": "none"
    },
    "non_authorizing": {
      "const": true
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "annotations": {
      "type": "object"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_layer": {
      "enum": [
        "rules",
        "scenarios"
      ]
    },
    "states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "defined",
          "implemented",
          "tested",
          "independently_qualified",
          "excluded_or_unsupported"
        ]
      }
    },
    "assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogue_completeness",
        "implementation_coverage",
        "test_coverage",
        "independent_qualification"
      ],
      "properties": {
        "catalogue_completeness": {
          "$ref": "#/$defs/assess_c"
        },
        "implementation_coverage": {
          "$ref": "#/$defs/assess_l"
        },
        "test_coverage": {
          "$ref": "#/$defs/assess_l"
        },
        "independent_qualification": {
          "$ref": "#/$defs/assess_q"
        }
      }
    },
    "mvp_applicability": {
      "type": "string",
      "minLength": 1
    },
    "status_note": {
      "const": "derived_projection_not_a_qualification_claim"
    }
  }
}
